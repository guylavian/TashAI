# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3100
RELAY_API_KEY=                # optional bearer token for /remote + /parse; empty disables auth
HOST=0.0.0.0
LOG_LEVEL=info          # trace | debug | info | warn | error

# ─── LM Studio ─────────────────────────────────────────────────────────────────
# Per-model endpoint overrides (OpenShift AI etc.): {"model-id":{"url":"https://host/v1","api_key":"token"}}
MODEL_ENDPOINTS={}
LM_STUDIO_URL=http://localhost:1234/v1      # change to remote IP if needed
LM_STUDIO_API_KEY=lm-studio                # LM Studio default, change if you set one
LM_STUDIO_TIMEOUT_MS=120000
LM_STUDIO_MAX_RETRIES=2

# ─── SLLM Classifier ──────────────────────────────────────────────────────────
# Single-pass classifier. A strong model (qwen) classifies keyword-miss queries
# accurately on the first try; keyword fast-path + provenance short-circuit
# before it. CLASSIFIER_FALLBACK_MODEL adds a stronger second-stage re-check and
# is only useful with a WEAK primary (gemma/phi) — leave empty when the primary
# is already strong.
CLASSIFIER_MODEL=qwen2.5-coder-7b-instruct
CLASSIFIER_ENABLED=true
CLASSIFIER_CONFIDENCE_THRESHOLD=0.75      # below this → ROUTE_DEFAULT
CLASSIFIER_MAX_TOKENS=200
CLASSIFIER_TIMEOUT_MS=12000              # per-attempt timeout; request is aborted on expiry
CLASSIFIER_FALLBACK_MODEL=               # second-stage model (set != CLASSIFIER_MODEL to enable)
WARM_MODELS=true                         # warm hot-path models on boot; set false to skip

# ─── Model Routing ─────────────────────────────────────────────────────────────
# Model IDs as they appear in LM Studio. Leave blank to skip that route.
ROUTE_NETWORK=phi-3.5-mini-instruct
ROUTE_OPENSHIFT=qwen2.5-coder-7b-instruct
ROUTE_WINDOWS=phi-3.5-mini-instruct
ROUTE_SECURITY=qwen2.5-coder-7b-instruct
ROUTE_MONITORING=phi-3.5-mini-instruct
ROUTE_AUTOMATION=qwen2.5-coder-7b-instruct
ROUTE_DEFAULT=google/gemma-4-e4b
# Complexity overrides
ROUTE_SIMPLE=liquid/lfm2.5-1.2b          # trivial general questions only
ROUTE_COMPLEX=qwen2.5-coder-7b-instruct  # any domain, when tagged complex

# ─── History Compaction ────────────────────────────────────────────────────────
# Over this budget (chars/4 ≈ tokens) the middle of a long chat is summarized by
# the tiny ROUTE_SIMPLE model, keeping system + last 4 turns verbatim. 0 = off.
HISTORY_BUDGET_TOKENS=3000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_MS=2000
WEBHOOK_TIMEOUT_MS=10000
