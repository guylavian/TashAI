# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info          # trace | debug | info | warn | error

# ─── LM Studio ─────────────────────────────────────────────────────────────────
LM_STUDIO_URL=http://localhost:1234/v1      # change to remote IP if needed
LM_STUDIO_API_KEY=lm-studio                # LM Studio default, change if you set one
LM_STUDIO_TIMEOUT_MS=120000
LM_STUDIO_MAX_RETRIES=2

# ─── SLLM Classifier ──────────────────────────────────────────────────────────
# Set to the model ID of your small fast classifier (e.g. phi-3-mini-4k-instruct)
CLASSIFIER_MODEL=phi-3-mini-4k-instruct
CLASSIFIER_ENABLED=true
CLASSIFIER_CONFIDENCE_THRESHOLD=0.75     # below this → fall back to ROUTE_DEFAULT
CLASSIFIER_MAX_TOKENS=200

# ─── Model Routing ─────────────────────────────────────────────────────────────
# Model IDs as they appear in LM Studio. Leave blank to skip that route.
ROUTE_DEFAULT=llama-3.1-8b-instruct
ROUTE_CODE=deepseek-coder-v2-lite-instruct
ROUTE_MATH=qwen2-math-7b-instruct
ROUTE_CREATIVE=mistral-nemo-instruct
ROUTE_ANALYSIS=llama-3.1-8b-instruct
ROUTE_TRANSLATION=mistral-nemo-instruct
ROUTE_QA=llama-3.1-8b-instruct
# Complexity overrides — if set, beat category routes
ROUTE_SIMPLE=phi-3-mini-4k-instruct
ROUTE_COMPLEX=llama-3.3-70b-instruct

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_MS=2000
WEBHOOK_TIMEOUT_MS=10000
